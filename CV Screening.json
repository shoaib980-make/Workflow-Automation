    {
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR OPENROUTER API KEY"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "messages",
              "value": "={{\n[\n  {\n    role: \"system\",\n    content: \"You are a CV screening assistant. Analyze the CV against the job description. Return ONLY valid JSON without Markdown or code fences. Use exactly these fields: candidate_name (string), experience (string), skills (array of strings), score (integer 0-100), justification (string). Do not invent information.\"\n  },\n  {\n    role: \"user\",\n    content: \"CV Filename: \" + $json.file_name +\n      \"\\n\\nCV TEXT:\\n\" + $json.cv_text +\n      \"\\n\\nJOB DESCRIPTION:\\n\" + $json.job_description\n  }\n]\n}}"
            },
            {
              "name": "model",
              "value": "openai/gpt-4o-mini"
            },
            {
              "name": "temperature",
              "value": "={{ 0.1 }}"
            },
            {
              "name": "response_format",
              "value": "={{ { type: \"json_object\" } }}"
            }
          ]
        },
        "options": {
          "batching": {
            "batch": {}
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        304,
        -32
      ],
      "id": "fe25ad56-3b0e-423b-9057-562bbcb2fa52",
      "name": "HTTP Request",
      "retryOnFail": true,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\n\nconst source_id = $('Edit Fields2').isExecuted\n  ? $('Edit Fields2').item.json.source_id\n  : $('Edit Fields3').item.json.source_id;\n\nconst content = response.choices?.[0]?.message?.content;\n\nlet result;\n\ntry {\n  if (!content) {\n    throw new Error(\"AI returned empty content\");\n  }\n\n  result = JSON.parse(content);\n} catch (error) {\n  return [{\n    json: {\n      is_valid: false,\n      validation_error: error.message,\n      source_id: source_id\n    }\n  }];\n}\n\nconst errors = [];\n\nif (typeof result.candidate_name !== \"string\" ||\n    !result.candidate_name.trim()) {\n  errors.push(\"Missing candidate name\");\n}\n\nif (!result.experience) {\n  errors.push(\"Missing experience\");\n}\n\nif (!Array.isArray(result.skills) || result.skills.length === 0) {\n  errors.push(\"Skills must be a non-empty array\");\n}\n\nif (typeof result.score !== \"number\" ||\n    result.score < 0 ||\n    result.score > 100) {\n  errors.push(\"Score must be a number between 0 and 100\");\n}\n\nif (typeof result.justification !== \"string\" ||\n    !result.justification.trim()) {\n  errors.push(\"Missing justification\");\n}\n\nreturn [{\n  json: {\n    ...result,\n    source_id: source_id,\n    is_valid: errors.length === 0,\n    validation_error: errors.join(\", \")\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
